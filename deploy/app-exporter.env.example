# app_exporter 的运行参数。systemd 通过 EnvironmentFile 读这个文件。
# 改完执行 systemctl restart app-exporter 生效。
# 不想动 unit 文件才这么设计的：参数和启动命令分开，改错了一个也不会把服务改到起不来。

# /metrics 暴露端口（Prometheus 抓这里）
APP_EXPORTER_PORT=9877

# 写进指标的 host 标签值。必须是固定有限值，不要塞 IP 段或主机名通配
APP_EXPORTER_HOST_LABEL=app1

# 采集目标：走 Nginx（80）而不是直连 gunicorn（8000），量的才是用户真实路径
APP_EXPORTER_STATS_URL=http://127.0.0.1/api/stats

# 延迟探测的基地址与路径
APP_EXPORTER_PROBE_BASE=http://127.0.0.1
APP_EXPORTER_PROBE_PATH=/

# 内部采集间隔（秒）。比 Prometheus 的 15s 抓取间隔更密，是有意的：
# 应用面对的压力由这个值决定，不受外部抓取频率影响
APP_EXPORTER_INTERVAL=5

# 单次 HTTP 请求超时（秒）
APP_EXPORTER_TIMEOUT=3
